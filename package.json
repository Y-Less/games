{
  "name": "game-hub",
  "version": "1.0.0",
  "private": true,
  "license": "MPL-1.1",
  "type": "module",
  "description": "A generic game site: accounts, profiles, statistics and a menu of pluggable game modules.",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test server/*.test.js shared/*.test.js modules/*/*.test.js && vitest run",
    "test:server": "node --test server/*.test.js shared/*.test.js modules/*/*.test.js",
    "test:client": "vitest run",
    "test:ui": "node --test --test-concurrency=1 ui-tests/*.test.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "vue": "^3.5.44",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "concurrently": "^10.0.6",
    "jsdom": "^29.1.1",
    "puppeteer-core": "^25.16.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
