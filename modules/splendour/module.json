    { "key": "reservedCards", "label": "Cards reserved", "agg": "sum" },
    { "key": "turnsTaken", "label": "Turns taken", "agg": "sum" },
    { "key": "level3Bought", "label": "Level 3 development cards bought", "agg": "sum", "hidden": true },
    { "key": "nobleChoices", "label": "Turns two nobles came to visit and you chose", "agg": "sum", "hidden": true },
    { "key": "tokenReturns", "label": "Times you put tokens back after going over ten", "agg": "sum", "hidden": true },
    { "key": "pipped", "label": "Games where you were first to the target and still lost", "agg": "sum", "hidden": true }
  ],
  "achievements": [
