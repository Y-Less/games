      "levels": "easy",
      "stat": "reservedCards"
    },
    {
      "key": "pipped",
      "name": "Pipped",
      "text": "Be the first to reach the target, then lose",
      "levels": "unlock",
      "stat": "pipped"
    },
    {
      "key": "bought",
      "name": "Shopper",
      "text": "Buy {n} development cards",
