      "levels": "hard",
      "stat": "bottomRows"
    },
    {
      "key": "floor",
      "name": "Floored",
      "text": "Fill your floor",
      "levels": "unlock",
      "stat": "floorsFilled"
    },
    {
      "key": "grid",
      "name": "Neat and tidy",
      "text": "Fill every space of your wall",
      "levels": "unlock",
      "stat": "gridsFilled"
    },
    {
      "key": "columns",
      "name": "Vertical thinking",
      "text": "Complete {n} wall columns",
      "one": "Complete a wall column",
      "levels": "medium",
      "stat": "columnsCompleted"
    },
    {
      "key": "fullplate",
      "name": "The whole plate",
      "text": "Take every tile of one plate in a single turn",
      "levels": "unlock",
      "stat": "fullPlates"
    },
    {
      "key": "spotless",
      "name": "Spotless",
      "text": "Win a game without a single tile on your floor",
      "levels": "unlock",
      "stat": "cleanWins"
