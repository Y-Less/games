{
  "id": "azulejo",
  "name": "Azulejo",
  "description": "Draft painted tiles from the workshop's display plates and build a patterned wall. For two to five players, with computer players to fill the seats.",
  "minPlayers": 1,
  "maxPlayers": 5,
  "category": "strategy",
  "rules": "rules.md",
  "stats": [
    { "key": "rowsCompleted", "label": "Wall rows completed", "agg": "sum" },
    { "key": "columnsCompleted", "label": "Wall columns completed", "agg": "sum" },
    { "key": "colourSetsCompleted", "label": "Colour sets completed", "agg": "sum" },
    { "key": "floorPenalties", "label": "Points lost to the floor", "agg": "sum" },
    { "key": "roundsPlayed", "label": "Rounds played", "agg": "sum" },
    { "key": "bottomRows", "label": "Games ending with the bottom row of your wall filled", "agg": "sum", "hidden": true },
    { "key": "tilesTaken", "label": "Tiles taken", "agg": "sum", "hidden": true },
    { "key": "tilesDropped", "label": "Tiles dropped on the floor (with the first-player marker)", "agg": "sum", "hidden": true },
    { "key": "floorsFilled", "label": "Times you filled your floor", "agg": "sum", "hidden": true },
    { "key": "wallTiles", "label": "Tiles placed on your wall", "agg": "sum", "hidden": true },
    { "key": "gridsFilled", "label": "Games ending with every space of your wall filled", "agg": "sum", "hidden": true },
    { "key": "fullPlates", "label": "Plates you emptied in a single turn", "agg": "sum", "hidden": true },
    { "key": "cleanWins", "label": "Games won with nothing ever on your floor", "agg": "sum", "hidden": true }
  ],
  "achievements": [
    {
      "key": "points",
      "name": "Running total",
      "text": "Score {n} points",
      "levels": "veryEasy",
      "stat": "totalScore"
    },
    {
      "key": "taken",
      "name": "Tile collector",
      "text": "Take {n} tiles",
      "one": "Take a tile",
      "levels": "veryEasy",
      "stat": "tilesTaken"
    },
    {
      "key": "dropped",
      "name": "Get smashed",
      "text": "Drop {n} tiles on the floor",
      "one": "Drop a tile on the floor",
      "levels": "easy",
      "stat": "tilesDropped"
    },
    {
      "key": "sets",
      "name": "Colour set",
      "text": "Complete {n} colour sets",
      "one": "Complete a colour set",
      "levels": "hard",
      "stat": "colourSetsCompleted"
    },
    {
      "key": "bottom",
      "name": "Solid foundations",
      "text": "Finish a game with your bottom row filled {n} times",
