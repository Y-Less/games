{
  "id": "trivium",
  "name": "Trivium",
  "description": "A fast quiz. Spin for a category, then race everybody to the right answer: the sooner you tap it, the more it is worth.",
  "minPlayers": 2,
  "maxPlayers": 8,
  "category": "party",
  "rules": "rules.md",
  "stats": [
    { "key": "rightAnswers", "label": "Questions answered correctly", "agg": "sum" },
    { "key": "answersGiven", "label": "Questions answered", "agg": "sum" },
    { "key": "fastestRight", "label": "Questions you answered correctly first", "agg": "sum" },
    { "key": "bestRound", "label": "Best round", "agg": "max" },
    { "key": "questionsMissed", "label": "Questions you let go by", "agg": "sum", "hidden": true },
    { "key": "perfectRounds", "label": "Rounds with every question right", "agg": "sum", "hidden": true },
    { "key": "perfectGames", "label": "Games with every question right", "agg": "sum", "hidden": true },
    { "key": "soleRight", "label": "Questions only you got right", "agg": "sum", "hidden": true },
    { "key": "snapAnswers", "label": "Right answers given in under two seconds", "agg": "sum", "hidden": true },
    { "key": "bullseyes", "label": "Answers tapped dead centre", "agg": "sum", "hidden": true },
    { "key": "edgeClicks", "label": "Answers tapped right on the edge", "agg": "sum", "hidden": true },
    { "key": "lastButRight", "label": "Questions you answered last and still got right", "agg": "sum", "hidden": true }
  ]
}
